# Copy to .env for local development. Never commit the copied file.

NODE_ENV=development
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8787
DATABASE_URL=postgresql://localhost:5432/computercraft_agents
GATEWAY_BEARER_SECRET=replace-with-a-local-secret
CONTROL_PLANE_ADMIN_SECRET=replace-with-a-local-admin-secret
GATEWAY_TIMEOUT_SECONDS=45
WORKER_TIMEOUT_SECONDS=45
MAX_HTTP_BODY_BYTES=1048576
STALE_CHECK_INTERVAL_SECONDS=10
CODEX_COMMAND=codex
REASONING_MAX_CONCURRENCY=2
LOG_LEVEL=info

{
  "name": "computercraft-agents",
  "version": "0.1.0",
  "private": true,
  "description": "ComputerCraft-first autonomous Minecraft workers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1112zakaria/computercraft-agents.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node packages/database/scripts/copy-migrations.mjs",
    "cli": "tsx apps/cli/src/main.ts",
    "clean": "tsc -b tsconfig.build.json --clean",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "release:lua": "node scripts/package-release.mjs",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"config/**/*.json\" \"eslint.config.mjs\" \"package.json\" \"tsconfig*.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"config/**/*.json\" \"eslint.config.mjs\" \"package.json\" \"tsconfig*.json\" \".prettierrc.json\"",
    "lint": "eslint .",
    "test": "npm run build && tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -b tsconfig.build.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.20.0",
    "luaparse": "^0.3.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}

[Unit]
Description=ComputerCraft Agents PostgreSQL backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/computercraft-agents-postgres-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/backups/computercraft-agents

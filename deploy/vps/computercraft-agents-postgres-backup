#!/bin/sh
set -eu

environment_file=/etc/computercraft-agents/control-plane.env
backup_directory=/var/backups/computercraft-agents
retention_days=14
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
backup_file="$backup_directory/postgres-$timestamp.dump"

if [ ! -r "$environment_file" ]; then
  echo "missing $environment_file" >&2
  exit 1
fi

# The environment file is root-owned and mode 0600. It is sourced only to obtain DATABASE_URL;
# the URL and database contents are never printed.
set -a
. "$environment_file"
set +a
: "${DATABASE_URL:?DATABASE_URL is required in $environment_file}"

install -d -o ubuntu -g ubuntu -m 0700 "$backup_directory"
umask 077
/usr/bin/pg_dump --format=custom --no-owner --file="$backup_file" "$DATABASE_URL"
/usr/bin/sha256sum "$backup_file" > "$backup_file.sha256"

find "$backup_directory" -type f \( -name 'postgres-*.dump' -o -name 'postgres-*.dump.sha256' \) \
  -mtime "+$retention_days" -delete

echo "Created PostgreSQL backup $backup_file"
